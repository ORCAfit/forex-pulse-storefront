# Copy to .env locally. NEVER commit a real .env — it is gitignored.
# On Render, set these same keys in the dashboard (Environment tab)
# or via render.yaml envVars. Values marked "sync: false" in render.yaml
# must be entered by hand in the Render dashboard.

# Public URL of the deployed storefront (no trailing slash)
BASE_URL=https://4xpulse.com

# --- Stripe (from the Stripe dashboard: Developers → API keys) ---
# Use TEST keys first (sk_test_...), switch to live keys (sk_live_...) when ready to sell.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# Webhook signing secret for the endpoint below (Stripe dashboard → Developers → Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# --- Owner access ---
# Passcode for the /owner area. Choose your own — do NOT reuse the private app's passkey.
OWNER_PASSCODE=CHOOSE_A_PASSCODE
# Random secret used to sign the owner session cookie (any long random string)
SESSION_SECRET=GENERATE_A_LONG_RANDOM_STRING

# --- Buyer confirmation email (SMTP) ---
# Any SMTP provider works (Gmail app password, SendGrid, Mailgun, etc.).
# If left unset, no email is sent and the Orders page shows the manual-send notice instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=REPLACE_ME
SMTP_FROM=Forex Pulse <you@example.com>

# --- Database ---
# Local default: ./data/forex-pulse.db. On Render the render.yaml sets this
# to the persistent disk path /var/data/forex-pulse.db.
DATABASE_PATH=./data/forex-pulse.db

PORT=3000
